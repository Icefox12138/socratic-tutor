{
  "name": "dsh-socratic",
  "version": "0.2.4",
  "private": false,
  "description": "Socratic tutor tools for DSH: cited retrieval, page images, chapter index, session review",
  "keywords": [
    "dsh-plugin",
    "tutor",
    "rag",
    "citations",
    "chinese-classics"
  ],
  "license": "MIT",
  "type": "module",
